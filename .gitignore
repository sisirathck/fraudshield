# .gitignore — FraudShield

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Build & distribution
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
venv/
env/
.env/
.venv/
ENV/

# Jupyter
.ipynb_checkpoints/

# Database (auto-generated by data/generate_data.py — excluded to keep repo lightweight)
data/*.db
data/*.sqlite
*.db
*.sqlite3

# Generated outputs (reproducible via analysis scripts)
outputs/figures/*.png
outputs/figures/*.jpg
outputs/reports/

# Trained model artifacts
*.pkl
*.joblib
*.h5
models/

# macOS system files
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*

# IDE/editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Secrets & environment variables
.env
.env.local
.env.production
secrets.yaml
config.secret.yaml

# Temporary files
tmp/
temp/
*.tmp

# AI assistant context files
CLAUDE.md
GIT_SETUP_GUIDE.md
